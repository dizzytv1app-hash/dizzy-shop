# BotFather'dan olingan bot tokeni (MAJBURIY)
BOT_TOKEN=

# Sizning shaxsiy Telegram ID raqamingiz - bot birinchi marta ishga tushganda
# sizni avtomatik ravishda "bot egasi" (asosiy admin) qilib qo'yadi.
# ID ni bilish uchun @userinfobot ga /start bosing.
OWNER_TELEGRAM_ID=

# Web-sayt tayyor bo'lgach va hostingga qo'yilgach, shu yerga to'liq manzilni yozing.
# Masalan: https://mystore.uz
# Bo'sh qoldirilsa, /start xabaridagi "saytga o'tish" tugmasi ko'rinmaydi.
WEBSITE_URL=

# Ma'lumotlar bazasi (SQLite - o'zgartirish shart emas)
DATABASE_URL=sqlite:///./shop.db
